<Window x:Class="BunnyPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="민트 키우기"
        Width="107" Height="100"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="True"
        PreviewKeyDown="OnKeyDown"
        MouseDoubleClick="OnMouseDoubleClick">
    <Grid x:Name="Root"
          Width="107" Height="100"
          Background="Transparent"
          MouseEnter="OnMouseEnter"
          MouseMove="OnMouseMove"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          MouseRightButtonUp="OnMouseRightButtonUp">
        <Image x:Name="ItemHouse"
               Panel.ZIndex="1"
               Width="105" Height="96"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Source="/Assets/item-house.png"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
        <Image x:Name="ItemChair"
               Panel.ZIndex="1"
               Width="68" Height="74"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="0,0,0,2"
               Source="/Assets/item-chair.png"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
        <Grid x:Name="DirectionLayer"
              Panel.ZIndex="2"
              Width="97" Height="88"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DirectionTransform" ScaleX="-1" ScaleY="1" />
            </Grid.RenderTransform>
            <Image x:Name="BunnyImage"
                   Width="97" Height="88"
                   Stretch="Uniform"
                   StretchDirection="Both"
                   VerticalAlignment="Bottom"
                   Source="/Assets/bunny-sleep.png"
                   RenderTransformOrigin="0.5,1"
                   IsHitTestVisible="False" />
        </Grid>
        <Image x:Name="ItemDoll"
               Panel.ZIndex="3"
               Width="40" Height="44"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Margin="2,0,0,2"
               Source="/Assets/item-doll.png"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
        <Image x:Name="ItemHay"
               Panel.ZIndex="3"
               Width="38" Height="36"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,2,2"
               Source="/Assets/item-hay.png"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
        <Image x:Name="ItemBag"
               Panel.ZIndex="3"
               Width="34" Height="34"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="-18,0,0,16"
               Source="/Assets/item-bag.png"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
        <Grid x:Name="MessageBorder"
              Panel.ZIndex="5"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="2,1,2,0"
              Opacity="0"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center">
                <Border Padding="5,3"
                        Background="#F8FFFDF9"
                        BorderBrush="#3D68584C"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="MessageEmoji"
                               Width="20" Height="20"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed" />
                        <TextBlock x:Name="Message"
                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Malgun Gothic, sans-serif"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="#51463F"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap"
                                   Visibility="Collapsed"
                                   Padding="0" />
                    </Grid>
                </Border>
                <Path Data="M 0,0 L 3,3 L 6,0"
                      Fill="#F8FFFDF9"
                      Stroke="#3D68584C"
                      StrokeThickness="1"
                      HorizontalAlignment="Center"
                      Margin="0,-1,0,0" />
            </StackPanel>
        </Grid>
        <Canvas x:Name="Hearts" Panel.ZIndex="4" IsHitTestVisible="False" />
    </Grid>
</Window>
