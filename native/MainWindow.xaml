<Window x:Class="BunnyPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="107" Height="100"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="True"
        MouseDoubleClick="OnMouseDoubleClick">
    <Grid x:Name="Root"
          Width="107" Height="100"
          Background="Transparent"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          KeyDown="OnKeyDown">
        <Grid x:Name="DirectionLayer"
              Width="97" Height="88"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DirectionTransform" ScaleX="-1" ScaleY="1" />
            </Grid.RenderTransform>
            <Image x:Name="BunnyImage"
                   Width="97" Height="88"
                   Stretch="Uniform"
                   StretchDirection="Both"
                   VerticalAlignment="Bottom"
                   Source="/Assets/bunny-idle.png"
                   RenderTransformOrigin="0.5,1"
                   IsHitTestVisible="False" />
        </Grid>
        <Border x:Name="MessageBorder"
                   Panel.ZIndex="5"
                   Width="103"
                   MaxWidth="103"
                   Margin="2,1,2,0"
                   Padding="4,3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Background="#F5FFFDF8"
                   BorderBrush="#2E68584C"
                   BorderThickness="1"
                   CornerRadius="6"
                   Opacity="0"
                   Visibility="Collapsed"
                   IsHitTestVisible="False">
            <TextBlock x:Name="Message"
                   FontFamily="Malgun Gothic"
                   FontSize="8"
                   FontWeight="Bold"
                   Foreground="#51463F"
                   TextAlignment="Center"
                   TextWrapping="NoWrap"
                   Padding="0" />
        </Border>
        <Canvas x:Name="Hearts" Panel.ZIndex="4" IsHitTestVisible="False" />
    </Grid>
</Window>
